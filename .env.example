# zero2agent 环境变量模板
#
# 用法：cp .env.example .env.local，然后填入自己的 API KEY
# .env.local 已在 .gitignore 中，不会被提交

# ── 必需 ──────────────────────────────────────────

ANTHROPIC_API_KEY=

# ── 可选：切换到 Anthropic 兼容的其他厂商 ─────────
#
# 本项目只用 Anthropic 官方 SDK，改 baseURL 即可换厂商。
# 注意必须填「Anthropic 兼容端点」，不要填 OpenAI 兼容端点（/v1）。
#
# MiniMax（国内）：https://api.minimaxi.com/anthropic
# MiniMax（Global）：https://api.minimax.io/anthropic

# ANTHROPIC_BASE_URL=
# MODEL_NAME=

# ── 可选：E2E 测试 ────────────────────────────────
#
# 真实 LLM 层的 E2E 默认跳过，置为 1 才会执行（会消耗 token）

# E2E_LIVE=1
