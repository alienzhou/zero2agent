# zero2agent 环境变量模板
#
# 用法：cp .env.example .env.local，然后填入自己的 API KEY
# .env.local 已在 .gitignore 中，不会被提交

# ── 必需 ──────────────────────────────────────────

ANTHROPIC_API_KEY=

# ── 可选：切换到 Anthropic 兼容的其他厂商 ─────────
#
# 本项目只用 Anthropic 官方 SDK，改 baseURL 即可换厂商。
# 注意必须填「Anthropic 兼容端点」，不要填 OpenAI 兼容端点（/v1）。
#
# MiniMax（国内）：https://api.minimaxi.com/anthropic
# MiniMax（Global）：https://api.minimax.io/anthropic

# ANTHROPIC_BASE_URL=
# MODEL_NAME=

# ── 上下文预算 ──────────────────────────────────────
# 默认模型已知窗口；切换模型时按供应商规格显式配置，不能猜测。
# 预算包含 system、工具定义、消息、输出预留和安全余量。
# CONTEXT_WINDOW=200000
# MAX_INPUT_TOKENS=190000
# MAX_OUTPUT_TOKENS=4096
# CONTEXT_COUNTING=conservative
# provider 模式要求兼容端点支持 messages/count_tokens；计数失败不会绕过检查。

# ── 可选：E2E 测试 ────────────────────────────────
#
# 真实 LLM 层的 E2E 默认跳过，置为 1 才会执行（会消耗 token）
# 将本文件复制为 .env.local 后填入 ANTHROPIC_API_KEY（已在 .gitignore，不会入库）

# E2E_LIVE=1
